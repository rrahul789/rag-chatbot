# Copy to .env and fill in. All values shown are the defaults from app/config.py.
# LLM: Ollama (local). Embeddings: local HuggingFace model. No API keys needed.

# --- Models --------------------------------------------------------------
LLM_MODEL=qwen3:1.7b
LLM_TEMPERATURE=0.0
OLLAMA_BASE_URL=http://localhost:11434

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store --------------------------------------------------------
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION_NAME=knowledge_base

# --- Chunking / retrieval -------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.25

# --- Data locations --------------------------------------------------------
DOCUMENTS_DIR=./data/sample_docs
UPLOADS_DIR=./data/uploads

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Observability -------------------------------------------------------------
LOG_LEVEL=INFO
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=            # set these two + tracing above to send traces to LangSmith
# LANGCHAIN_PROJECT=rag-chatbot
